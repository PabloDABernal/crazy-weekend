; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Crazy Weekend"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoloads/event_bus.gd"
MetaProgress="*res://autoloads/meta_progress.gd"
NarrativePhase="*res://autoloads/narrative_phase.gd"
RunState="*res://autoloads/run_state.gd"
EconomyRules="*res://autoloads/economy_rules.gd"
LeagueRules="*res://autoloads/league_rules.gd"
LeagueState="*res://autoloads/league_state.gd"
VictoryTracker="*res://autoloads/victory_tracker.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
